---
const services = [
  {
    title: 'Website Design & Redesign',
    description:
      'For businesses that need a stronger first impression, clearer service architecture, and a website that turns more visitors into qualified inquiries.',
    bullets: [
      'Homepage and service-page strategy',
      'Conversion-focused structure and trust sections',
      'Mobile-first build with SEO foundations'
    ],
    href: '/web-design-new-jersey',
    cta: 'Explore Web Design',
  },
  {
    title: 'Local SEO + Google Business',
    description:
      'For businesses that want more local visibility without wasting traffic on weak landing pages or disconnected SEO work.',
    bullets: [
      'Technical cleanup and local intent alignment',
      'GBP and website signal reinforcement',
      'Content and conversion improvements that work together'
    ],
    href: '/local-seo-new-jersey',
    cta: 'Explore Local SEO',
  },
  {
    title: 'Website Care Plans',
    description:
      'For businesses that want the site to stay updated, protected, and usable after launch instead of slowly falling out of date.',
    bullets: [
      'Updates, backups, monitoring, and edits',
      'Ongoing polish and issue prevention',
      'A cleaner retention path after launch'
    ],
    href: '/website-maintenance-care-plans',
    cta: 'Explore Care Plans',
  },
];
---

<section class="section-padding bg-white">
  <div class="content-width">
    <div class="max-w-3xl mb-14">
      <p class="section-overline">Core services</p>
      <h2 class="heading-lg mb-5">Three Core Offers. One Commercial Goal.</h2>
      <p class="text-stone-600 text-lg">
        The site is intentionally focused around three offers because most local businesses do not need a bloated agency menu. They need a better website, stronger local visibility, and a practical path to maintain momentum after launch. Each offer exists to solve a different stage of that problem.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {services.map((s) => (
        <article class="card-premium p-8 flex flex-col">
          <h3 class="text-xl font-semibold text-stone-900 mb-3">{s.title}</h3>
          <p class="text-stone-600 mb-5">{s.description}</p>

          <ul class="space-y-2.5 text-sm text-stone-600 mb-6">
            {s.bullets.map((bullet) => (
              <li class="flex gap-3 items-start">
                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                {bullet}
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-2">
            <a href={s.href} class="inline-flex items-center gap-1.5 font-semibold text-[#1e3a5f] hover:gap-2.5 transition-all duration-200 text-sm">
              {s.cta}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
