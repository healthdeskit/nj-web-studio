---
import { SITE, NAV_LINKS, CTAS } from '../config/site';
---

<header class="sticky top-0 z-50 bg-white/98 backdrop-blur-md border-b border-stone-200/80 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 md:h-20 gap-6">
      <a href="/" class="shrink-0 flex items-center" aria-label="NJ Web Studio - Home">
        <img src="/logo.svg" alt="" class="h-9 md:h-10 w-auto" width="180" height="44" />
      </a>

      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Main navigation">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2.5 rounded-lg text-sm font-medium text-stone-600 hover:text-[#1e3a5f] hover:bg-stone-100/80 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/contact"
          class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-lg font-semibold text-sm text-white bg-[#1e3a5f] hover:bg-[#2d4a6f] transition-colors shadow-sm hover:shadow-md"
        >
          Free Audit
        </a>
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2.5 -m-2.5 text-stone-600 hover:text-stone-900 hover:bg-stone-100 rounded-lg transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-stone-200/80">
      <nav class="py-4 flex flex-col gap-0.5" aria-label="Mobile navigation">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="px-4 py-3 rounded-lg text-stone-600 hover:text-[#1e3a5f] hover:bg-stone-50 font-medium transition-colors"
          >
            {link.label}
          </a>
        ))}
        <div class="mt-3 pt-3 border-t border-stone-200">
          <a
            href="/contact"
            class="flex justify-center px-6 py-3.5 rounded-lg font-semibold text-white bg-[#1e3a5f] hover:bg-[#2d4a6f] transition-colors"
          >
            {CTAS.primary}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    btn?.setAttribute('aria-expanded', open ? 'false' : 'true');
  });
</script>
