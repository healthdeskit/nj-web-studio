---
import { SITE, CTAS } from '../config/site';
const currentYear = new Date().getFullYear();
const phoneHref = `tel:${SITE.phone.replace(/\D/g, '')}`;
const emailHref = `mailto:${SITE.email}`;
---

<footer class="bg-stone-900 text-stone-300">
  <div class="content-width section-padding">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">
      <div class="lg:col-span-2">
        <a href="/" class="font-serif font-bold text-2xl text-white block mb-4">{SITE.name}</a>
        <p class="text-stone-400 max-w-md mb-6">{SITE.description}</p>
        <p class="text-stone-400">{SITE.tagline}</p>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Services</h3>
        <ul class="space-y-3">
          <li><a href="/web-design-new-jersey" class="hover:text-white transition-colors">Web Design</a></li>
          <li><a href="/website-redesign-new-jersey" class="hover:text-white transition-colors">Website Redesign</a></li>
          <li><a href="/local-seo-new-jersey" class="hover:text-white transition-colors">Local SEO</a></li>
          <li><a href="/google-business-profile-optimization-nj" class="hover:text-white transition-colors">Google Business Profile</a></li>
          <li><a href="/website-maintenance-care-plans" class="hover:text-white transition-colors">Care Plans</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Connect</h3>
        <ul class="space-y-3">
          <li><a href={emailHref} class="hover:text-white transition-colors">{SITE.email}</a></li>
          <li><a href={phoneHref} class="hover:text-white transition-colors">{SITE.phone}</a></li>
          <li><a href="/contact" class="inline-flex items-center justify-center mt-4 px-4 py-2.5 rounded-lg font-semibold text-sm text-stone-900 bg-[#c9a227] hover:bg-[#d4af37]">{CTAS.primary}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-stone-700 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-stone-500 text-sm">� {currentYear} {SITE.name}. All rights reserved.</p>
      <div class="flex gap-6 text-sm">
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        <a href="/about" class="hover:text-white transition-colors">About</a>
      </div>
    </div>
  </div>
</footer>
