---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTASection from '../components/CTASection.astro';

interface Props {
  title: string;
  description: string;
  headline: string;
  subheadline: string;
  canonical: string;
  breadcrumb: Array<{ label: string; href?: string }>;
}

const { title, description, headline, subheadline, canonical, breadcrumb } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Breadcrumb items={breadcrumb} />
  <Hero headline={headline} subheadline={subheadline} variant="page" />
  <slot />
  <CTASection />
</BaseLayout>
