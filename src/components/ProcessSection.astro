---
const steps = [
  { num: '01', title: 'Audit & Strategy', desc: 'We review your current site, goals, and competition. You get a clear plan—no surprises.' },
  { num: '02', title: 'Design & Build', desc: 'Conversion-focused pages, strong UX, and technical SEO baked in from the start.' },
  { num: '03', title: 'Launch & Optimize', desc: 'We launch with confidence. Ongoing care and SEO keep you growing.' },
];
---

<section class="section-padding bg-white">
  <div class="content-width">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="heading-lg mb-4">How We Work</h2>
      <p class="text-stone-600 text-lg">A clear process reduces risk and keeps everyone aligned. No endless revisions, no scope creep.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {steps.map((s) => (
        <div class="relative">
          <span class="text-5xl font-bold text-[#1e3a5f]/20">{s.num}</span>
          <h3 class="text-xl font-semibold text-stone-900 mt-2 mb-3">{s.title}</h3>
          <p class="text-stone-600">{s.desc}</p>
          {s.num !== '03' && (
            <div class="hidden md:block absolute top-12 -right-4 w-8 h-0.5 bg-stone-200" aria-hidden="true" />
          )}
        </div>
      ))}
    </div>
  </div>
</section>
