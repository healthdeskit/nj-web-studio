---
const results = [
  { metric: 'Before/after positioning', desc: 'We reframe messaging so visitors understand value quickly and weak-fit inquiries drop.' },
  { metric: 'Conversion architecture', desc: 'Page flow rebuilt so proof appears before the ask and CTAs are impossible to miss.' },
  { metric: 'Technical foundation', desc: 'Schema, speed, metadata—built to rank and perform from launch.' },
  { metric: 'Ongoing support', desc: 'Care plans and SEO retainers keep sites updated and visibility growing.' },
];
---

<section class="section-padding bg-white">
  <div class="content-width">
    <div class="mb-12">
      <img src="/images/results-preview.webp" alt="Professional reviewing website performance and conversion metrics" class="w-full max-w-2xl mx-auto rounded-2xl border border-stone-200 shadow-md object-cover aspect-[3/2]" width="800" height="533" loading="lazy" decoding="async" />
    </div>
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="heading-lg mb-4">How We Create Results</h2>
      <p class="text-stone-600 text-lg">We do not fabricate metrics. We show what we changed, why it matters, and how it affects lead quality and visibility. <a href="/results" class="text-[#1e3a5f] font-semibold hover:underline">See our approach and proof</a>.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {results.map((r) => (
        <div class="card-premium p-6 text-center group hover:border-[#1e3a5f]/20 transition-colors">
          <span class="font-semibold text-[#1e3a5f] block mb-2">{r.metric}</span>
          <p class="text-stone-600 text-sm">{r.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/results" class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg font-semibold text-[#1e3a5f] border-2 border-[#1e3a5f] hover:bg-[#1e3a5f] hover:text-white">View our approach and results</a>
    </div>
  </div>
</section>
