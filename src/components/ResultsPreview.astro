---
const results = [
  { metric: 'Strategy-first', desc: 'Every project starts with clarity on outcomes, not just pages.' },
  { metric: 'Conversion-focused', desc: 'Forms, CTAs, and trust signals placed where they perform.' },
  { metric: 'Technical foundation', desc: 'Fast, secure, schema-ready. Built to rank from launch.' },
  { metric: 'Ongoing support', desc: 'Care plans keep sites updated and ready for growth.' },
];
---

<section class="section-padding bg-white">
  <div class="content-width">
    <div class="mb-12">
      <img src="/images/results-preview.webp" alt="Website performance dashboard showing growth and conversion metrics" class="w-full max-w-2xl mx-auto rounded-2xl border border-stone-200 shadow-md object-cover aspect-[3/2]" width="800" height="533" loading="lazy" decoding="async" />
    </div>
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="heading-lg mb-4">How We Approach Results</h2>
      <p class="text-stone-600 text-lg">We don't fabricate metrics. We deliver strategic execution—clear process, strong foundations, and honest proof of thinking.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {results.map((r) => (
        <div class="card-premium p-6 text-center group hover:border-[#1e3a5f]/20 transition-colors">
          <span class="font-semibold text-[#1e3a5f] block mb-2">{r.metric}</span>
          <p class="text-stone-600 text-sm">{r.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/results" class="inline-flex items-center justify-center px-6 py-3.5 rounded-lg font-semibold text-[#1e3a5f] border-2 border-[#1e3a5f] hover:bg-[#1e3a5f] hover:text-white">View our approach & results</a>
    </div>
  </div>
</section>
