---
import { SITE, CTAS } from '../config/site';
---

<div id="sticky-cta" class="fixed bottom-0 left-0 right-0 z-40 hidden p-3 sm:p-4 bg-white/95 backdrop-blur border-t border-stone-200 shadow-[0_-4px_20px_rgba(0,0,0,.08)] lg:hidden">
  <div class="max-w-6xl mx-auto px-4 flex items-center justify-between gap-3">
    <p class="text-sm font-medium text-stone-700 truncate min-w-0">Ready for a free audit?</p>
    <div class="flex gap-2 shrink-0">
      <a href="/contact" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg font-semibold text-sm text-white bg-[#1e3a5f] hover:bg-[#2d4a6f] whitespace-nowrap">Free Audit</a>
      <a href={`tel:${SITE.phone.replace(/\D/g, '')}`} class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg font-semibold text-sm text-[#1e3a5f] border-2 border-[#1e3a5f] hover:bg-[#1e3a5f] hover:text-white whitespace-nowrap">Call</a>
    </div>
  </div>
</div>

<script>
  const stickyCta = document.getElementById('sticky-cta');
  if (stickyCta) {
    let lastScroll = 0;
    const threshold = 400;
    const toggle = () => {
      const scroll = window.scrollY;
      const isMobile = window.innerWidth < 1024;
      if (isMobile && scroll > threshold) {
        stickyCta.classList.remove('hidden');
      } else {
        stickyCta.classList.add('hidden');
      }
      lastScroll = scroll;
    };
    window.addEventListener('scroll', () => requestAnimationFrame(toggle), { passive: true });
    window.addEventListener('resize', toggle);
  }
</script>
