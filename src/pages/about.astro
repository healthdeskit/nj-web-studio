---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';

const faqs = [
  { q: 'What makes NJ Web Studio different from a general agency?', a: 'We are intentionally focused on website design, local SEO, and maintenance for New Jersey service businesses. That focus improves strategy quality and execution depth.' },
  { q: 'Do you only work with specific industries?', a: 'We serve a range of local service businesses, but we prioritize trust-heavy niches like dentists, med spas, and law firms where positioning and conversion quality are critical.' },
  { q: 'Can you support us long-term after launch?', a: 'Yes. We offer care plans and monthly SEO support so your site remains secure, relevant, and performance-oriented after launch.' },
];
---

<BaseLayout
  title="About"
  description="NJ Web Studio is a premium local growth partner for New Jersey service businesses, focused on lead-focused web design, local SEO, and ongoing website care."
  canonical="/about"
  ogImage="/og-image.jpg"
>
  <Breadcrumb items={[{ label: 'About' }]} />
  <Hero
    headline="A Premium Local Growth Studio for NJ Service Businesses"
    subheadline="Built for business owners who need outcomes, not just a prettier website."
    variant="page"
  />

  <section class="section-padding bg-white">
    <div class="content-width">
      <div class="grid lg:grid-cols-2 gap-10">
        <div class="card-premium p-8">
          <h2 class="heading-md mb-5">Why We Exist</h2>
          <p class="text-stone-600 mb-4">Most small business websites are built like brochures. They explain services, but they do not guide users to convert. NJ Web Studio was built to fix that gap with strategy-led design and local SEO architecture.</p>
          <p class="text-stone-600">Our work is designed to increase trust quickly, improve lead quality, and create clearer growth signals across your digital presence.</p>
        </div>
        <div class="card-premium p-8">
          <h2 class="heading-md mb-5">What We Focus On</h2>
          <ul class="space-y-3 text-stone-600 list-disc list-inside">
            <li>Website design and redesign built for conversion</li>
            <li>Local SEO and GBP optimization for visibility</li>
            <li>Ongoing care plans to protect performance</li>
          </ul>
          <p class="text-stone-600 mt-4">We intentionally avoid bloated agency service menus so execution stays sharp and accountable.</p>
        </div>
      </div>

      <div class="mt-10 card-proof">
        <h2 class="heading-md mb-4">How We Work</h2>
        <p class="text-stone-600 mb-3">Every project starts with clarity: offer positioning, audience intent, and conversion objectives. Design follows strategy, and technical SEO is baked in from the start.</p>
        <p class="text-stone-600">We communicate directly, set clear scope, and build with long-term maintainability in mind so your site can evolve without becoming fragile.</p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-stone-50">
    <div class="content-width">
      <h2 class="heading-lg mb-8 text-center">Industries We Prioritize</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/web-design-dentists-new-jersey" class="card-premium p-6 block hover:border-[#1e3a5f]/30 transition-colors">
          <h3 class="heading-sm mb-2">Dentists</h3>
          <p class="text-stone-600">Provider trust, treatment clarity, and appointment-driven conversion flow.</p>
          <span class="inline-flex items-center gap-1 mt-3 font-semibold text-[#1e3a5f] text-sm">Learn more →</span>
        </a>
        <a href="/web-design-med-spas-new-jersey" class="card-premium p-6 block hover:border-[#1e3a5f]/30 transition-colors">
          <h3 class="heading-sm mb-2">Med Spas</h3>
          <p class="text-stone-600">Premium brand perception with booking-focused UX and local visibility.</p>
          <span class="inline-flex items-center gap-1 mt-3 font-semibold text-[#1e3a5f] text-sm">Learn more →</span>
        </a>
        <a href="/web-design-law-firms-new-jersey" class="card-premium p-6 block hover:border-[#1e3a5f]/30 transition-colors">
          <h3 class="heading-sm mb-2">Law Firms</h3>
          <p class="text-stone-600">Authority positioning, case-type clarity, and consultation conversion paths.</p>
          <span class="inline-flex items-center gap-1 mt-3 font-semibold text-[#1e3a5f] text-sm">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} />
  <CTASection />
</BaseLayout>
