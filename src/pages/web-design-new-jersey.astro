---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTASection from '../components/CTASection.astro';
import FAQSection from '../components/FAQSection.astro';
import ServiceSchema from '../components/ServiceSchema.astro';

const faqs = [
  { q: 'Do you only build websites for one industry?', a: 'No. We specialize in New Jersey service businesses, with deeper experience in dentists, med spas, and law firms. We adapt structure and messaging by niche so pages match buyer behavior.' },
  { q: 'Can you redesign an existing site instead of building from scratch?', a: 'Yes. Many projects begin as redesigns. We audit what to keep, what to replace, and how to rebuild conversion flow without losing important SEO value.' },
  { q: 'What makes your web design process different?', a: 'We lead with strategy first: positioning, trust architecture, and conversion paths. Design is executed to support those outcomes, not just visual polish.' },
];
---

<BaseLayout
  title="Web Design New Jersey | Lead-Focused Websites for NJ Service Businesses"
  description="Professional web design for New Jersey service businesses. Dentists, med spas, law firms. Built for trust, conversion, and local visibility."
  canonical="/web-design-new-jersey"
  ogImage="/og-image.jpg"
>
  <ServiceSchema
    name="Website Design"
    description="Lead-focused website design for New Jersey service businesses."
    path="/web-design-new-jersey"
  />

  <Breadcrumb items={[{ label: 'Web Design', href: '/web-design-new-jersey' }]} />
  <Hero
    headline="Web Design for New Jersey Service Businesses"
    subheadline="Not just a website—a lead generation system. We build sites that communicate authority, capture intent, and drive calls. Built for dentists, med spas, law firms, and serious local businesses."
    variant="page"
  />

  <section class="section-padding bg-white">
    <div class="content-width">
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="heading-md mb-6">Not Just a Website—A Lead Generation System</h2>
          <p class="text-stone-600 text-lg mb-6">Your website should do more than look modern. It should communicate authority fast, guide visitors to contact actions, and support local search growth over time. That requires strategic web design: every page has a job, every section answers an objection, and every CTA is placed where intent is highest.</p>
          <p class="text-stone-600 text-lg">We do not hand you a template and call it done. We map your offer, your audience, and your competitive landscape—then design a site that earns its keep.</p>
        </div>
        <img src="/images/hero-website-growth.webp" alt="Laptop displaying modern service business website with trust-focused layout" class="w-full rounded-2xl border border-stone-200 shadow-lg object-cover aspect-[4/3]" width="800" height="600" loading="lazy" decoding="async" />
      </div>

      <div class="mb-16">
        <h2 class="heading-md mb-6">Why Cheap or Generic Design Fails</h2>
        <p class="text-stone-600 text-lg mb-6">Template-based builds and low-budget design shops prioritize speed over conversion. The result: a site that looks acceptable but does not guide visitors to act. Generic headlines, weak trust blocks, buried contact paths, and no alignment with how real buyers research and decide. You get traffic—or worse, you do not—but either way, calls do not materialize.</p>
        <p class="text-stone-600 text-lg mb-6">We fix that by designing for conversion from the start. Positioning first. Trust architecture second. Visual design third. Technical SEO baked in throughout.</p>
        <h3 class="text-lg font-semibold text-stone-900 mb-4">What Strategic Web Design Includes</h3>
        <p class="text-stone-600 mb-4">Before we design a single page, we clarify your offer, your audience, and what happens when someone lands. That means mapping the buyer journey: What do they need to see before they are willing to call? What objections do they have? Where should the CTA live? We then structure pages around that logic—trust before ask, proof before push.</p>
        <p class="text-stone-600">We also build with technical SEO in mind from day one. Clean URLs, schema markup, fast load times, and mobile-first layout. A beautiful site that does not rank or convert is a liability. We avoid that by integrating structure, design, and technical execution from the beginning.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <div class="card-premium p-8">
          <h3 class="text-xl font-semibold text-stone-900 mb-4">Who This Is For</h3>
          <p class="text-stone-600 mb-4">Businesses ready to move beyond generic templates and build a site that matches service quality and growth goals. You need a site that reflects your expertise and converts visitors into callers.</p>
          <ul class="text-stone-600 space-y-2 list-disc list-inside">
            <li>Dentists and dental practices</li>
            <li>Med spas and aesthetic practices</li>
            <li>Law firms and attorneys</li>
            <li>Other trust-heavy local service businesses</li>
          </ul>
        </div>
        <div class="card-premium p-8">
          <h3 class="text-xl font-semibold text-stone-900 mb-4">What You Get</h3>
          <ul class="text-stone-600 space-y-2 list-disc list-inside">
            <li>Mobile-first conversion flow and CTA architecture</li>
            <li>Strong trust blocks, proof placement, and objection handling</li>
            <li>On-page SEO and local schema readiness</li>
            <li>Contact funnel setup with form and phone pathways</li>
            <li>Scalable page structure for future growth</li>
          </ul>
        </div>
      </div>

      <h2 class="heading-md mb-8">Packages</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card-elevated p-8">
          <h3 class="text-lg font-semibold text-stone-900 mb-2">Starter Redesign</h3>
          <p class="text-[#1e3a5f] font-bold mb-4">$2,500 – $3,500</p>
          <p class="text-stone-600 text-sm mb-4">Best for solo or small local businesses. 5–7 pages and a clear conversion foundation.</p>
          <a href="/contact#audit" class="btn-secondary text-sm py-2.5">Get Started</a>
        </div>
        <div class="card-elevated p-8 border-2 border-[#1e3a5f]">
          <span class="text-xs font-semibold text-[#1e3a5f] uppercase tracking-wide">Most Popular</span>
          <h3 class="text-lg font-semibold text-stone-900 mb-2 mt-2">Growth Redesign</h3>
          <p class="text-[#1e3a5f] font-bold mb-4">$4,500 – $6,500</p>
          <p class="text-stone-600 text-sm mb-4">8–12 pages, deeper service architecture, proof modules, and stronger SEO structure.</p>
          <a href="/contact#audit" class="btn-primary text-sm py-2.5">Get Started</a>
        </div>
        <div class="card-elevated p-8">
          <h3 class="text-lg font-semibold text-stone-900 mb-2">Premium Niche Build</h3>
          <p class="text-[#1e3a5f] font-bold mb-4">$7,500 – $10,500</p>
          <p class="text-stone-600 text-sm mb-4">Full messaging strategy and custom conversion architecture for higher-ticket niches.</p>
          <a href="/contact#audit" class="btn-secondary text-sm py-2.5">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-stone-50">
    <div class="content-width">
      <h2 class="heading-md mb-8 text-center">Niche-Specific Expertise</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/web-design-dentists-new-jersey" class="card-premium p-6 block hover:border-[#1e3a5f]/30">
          <h3 class="font-semibold text-stone-900">Dentists</h3>
          <p class="text-stone-600 text-sm mt-1">Trust, treatment clarity, and appointment conversion.</p>
        </a>
        <a href="/web-design-med-spas-new-jersey" class="card-premium p-6 block hover:border-[#1e3a5f]/30">
          <h3 class="font-semibold text-stone-900">Med Spas</h3>
          <p class="text-stone-600 text-sm mt-1">Premium perception, booking intent, and treatment page structure.</p>
        </a>
        <a href="/web-design-law-firms-new-jersey" class="card-premium p-6 block hover:border-[#1e3a5f]/30">
          <h3 class="font-semibold text-stone-900">Law Firms</h3>
          <p class="text-stone-600 text-sm mt-1">Authority positioning and consultation-focused funnels.</p>
        </a>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} />
  <CTASection />
</BaseLayout>
