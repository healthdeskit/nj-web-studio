---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Thank You"
  description="Thank you for reaching out. We'll be in touch soon."
  canonical="/thank-you"
  noindex={true}
>
  <section class="section-padding min-h-[60vh] flex items-center">
    <div class="content-width text-center">
      <h1 class="heading-lg mb-4">Thank You</h1>
      <p class="text-xl text-stone-600 mb-8 max-w-xl mx-auto">We've received your request. We'll review your information and get back to you within 1–2 business days.</p>
      <p class="text-stone-500 mb-8">In the meantime, feel free to call us at <a href={`tel:${SITE.phone.replace(/\D/g, '')}`} class="text-primary font-semibold">{SITE.phone}</a> if you'd like to connect sooner.</p>
      <a href="/" class="btn-primary">Back to Home</a>
    </div>
  </section>
</BaseLayout>
