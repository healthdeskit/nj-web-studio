---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, ogImage, canonical = '/', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} />
    <Schema pagePath={canonical} pageTitle={title} />
  </head>
  <body class="min-h-screen flex flex-col" style="font-family: 'DM Sans', system-ui, sans-serif;">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <StickyCTA />
  </body>
</html>
